# Local-only input for scripts/configure-auth.mjs. Copy to .env.auth.local and fill the blanks.
# Do not add these values to Vercel or use NEXT_PUBLIC_ prefixes.
SUPABASE_PROJECT_REF=ulbmhpohfzafosjzycor
SUPABASE_ACCESS_TOKEN=
SUPABASE_AUTH_SITE_URL=https://kingdom-seekers-delight12.vercel.app
SUPABASE_AUTH_REDIRECT_URLS=https://kingdom-seekers-delight12.vercel.app,http://localhost:3000/**

# Obtain the login and full SMTP key from Brevo Settings > SMTP & API.
# Brevo shows the full key only when it is created; formats may vary.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Use a sender email/domain verified in Brevo.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Kingdom Seekers
